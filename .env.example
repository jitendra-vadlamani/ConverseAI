# ConverseAI Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# --- Application ---
PORT=8080
HOST_PORT_APP=8080

# --- Database (PostgreSQL) ---
POSTGRES_URI=postgres://postgres:postgres@localhost:5432/converseai?sslmode=disable

# --- Security ---
# Generate a long random string for production, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
# Must be exactly 32 bytes for AES-256-GCM field encryption
DB_ENCRYPTION_KEY=change-me-32-byte-encryption-key

# --- LLM Backend ---
LLM_BACKEND=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=gemma4-cos
OLLAMA_BASE_URL=http://localhost:11434

# --- Specialized Model Defaults (Auto-Routing) ---
EMBEDDING_MODEL=gemma4:e4b
DEFAULT_PLANNER_MODEL=gemma4:e4b
DEFAULT_CHAT_MODEL=gemma4:e4b
DEFAULT_OCR_MODEL=deepseek-ocr:3b
DEFAULT_VISION_MODEL=qwen3-vl:8b
DEFAULT_CODING_MODEL=qwen3-coder:latest
DEFAULT_TRANSLATION_MODEL=translategemma:12b

# --- Legacy (pre-Postgres-migration services, unused by default) ---
# MONGO_URI=mongodb://converseai-db:27017
# DB_NAME=ai_chat
# CHROMA_URL=http://converseai-vector:8000
# MINIO_ENDPOINT=converseai-storage:9000
# MINIO_ROOT_USER=admin
# MINIO_ROOT_PASSWORD=change-me
# MINIO_BUCKET=converseai
# MINIO_USE_SSL=false
