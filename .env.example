# ConverseAI configuration. Copy to .env and fill in every secret.
# The app refuses to start if a secret is empty or still a placeholder.

# --- Secrets (required) ---
# openssl rand -hex 32
JWT_SECRET=
# Exactly 32 characters: openssl rand -hex 16
DB_ENCRYPTION_KEY=
# Previous encryption keys, comma-separated, kept only while rotating:
#   1. move the old key here and put a new one in DB_ENCRYPTION_KEY
#   2. restart, then run: docker compose exec converseai converseai rotate-keys
#   3. remove the old key from this list
DB_ENCRYPTION_KEYS_OLD=

# MongoDB root user, created on first start of an empty volume.
# Use hex (openssl rand -hex 16) so the password is safe inside a URI.
MONGO_USER=converseai
MONGO_PASSWORD=
MINIO_ROOT_USER=converseai
MINIO_ROOT_PASSWORD=

# --- Network ---
HOST_BIND=0.0.0.0
HOST_PORT_APP=8080
# Cookies are Secure (HTTPS-only) by default. Set to false only when browsers
# reach the app over plain HTTP on a trusted LAN.
COOKIE_SECURE=true
# Set to true when a reverse proxy (Caddy, Tailscale Serve) sets X-Forwarded-For.
TRUST_PROXY=false
# HTTPS via the bundled Caddy (docker compose --profile tls up -d):
CONVERSEAI_DOMAIN=localhost
# "internal" = Caddy's own CA (LAN names); an email address = Let's Encrypt.
CADDY_TLS=internal

# --- Models (Ollama) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=nomic-embed-text-v2-moe:latest
DEFAULT_CHAT_MODEL=gemma4:latest
DEFAULT_OCR_MODEL=deepseek-ocr:3b
DEFAULT_VISION_MODEL=qwen3-vl:8b
DEFAULT_TRANSLATION_MODEL=translategemma:12b
# Cap on the context window requested from Ollama (KV cache must fit in VRAM).
MAX_NUM_CTX=8192
# Keep only one chat model loaded at a time (good for a single GPU).
SINGLE_MODEL_MODE=true
# Answers generated at the same time; the rest queue.
MAX_CONCURRENT_RUNS=2

# --- Optional ---
# Redis lets several app instances share live streams
# (docker compose --profile redis up -d, then REDIS_URL=redis://converseai-redis:6379).
REDIS_URL=
# OpenTelemetry traces, e.g. a self-hosted Langfuse or Phoenix OTLP endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
